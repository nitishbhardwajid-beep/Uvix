# SMTP example (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=team@yourdomain.com
TO_EMAIL=info@uvix.in

# Or SendGrid API
SENDGRID_API_KEY=SG.xxxxx
FROM_EMAIL=team@yourdomain.com
TO_EMAIL=info@uvix.in

# Other helpful vars
# NODE_ENV=production